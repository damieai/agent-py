{
  "name": "agent-py-langfuse-local",
  "services": {
    "web": {
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "clickhouse": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        }
      },
      "ports": [
        "127.0.0.1:3000:3000"
      ],
      "environment": {
        "NEXTAUTH_URL": "http://localhost:3000",
        "DATABASE_URL": "postgresql://langfuse:${POSTGRES_PASSWORD:?run scripts/langfuse_stack.py init}@postgres:5432/langfuse",
        "SALT": "${SALT:?run scripts/langfuse_stack.py init}",
        "ENCRYPTION_KEY": "${ENCRYPTION_KEY:?run scripts/langfuse_stack.py init}",
        "TELEMETRY_ENABLED": "false",
        "LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES": "false",
        "CLICKHOUSE_MIGRATION_URL": "clickhouse://clickhouse:9000",
        "CLICKHOUSE_URL": "http://clickhouse:8123",
        "CLICKHOUSE_USER": "langfuse",
        "CLICKHOUSE_PASSWORD": "${CLICKHOUSE_PASSWORD:?run scripts/langfuse_stack.py init}",
        "CLICKHOUSE_CLUSTER_ENABLED": "false",
        "CLICKHOUSE_CLUSTER_NAME": "default",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "REDIS_AUTH": "${REDIS_AUTH:?run scripts/langfuse_stack.py init}",
        "REDIS_TLS_ENABLED": "false",
        "LANGFUSE_S3_BATCH_EXPORT_ENABLED": "false",
        "LANGFUSE_S3_EVENT_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_EVENT_UPLOAD_REGION": "auto",
        "LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID": "langfuse",
        "LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY": "${MINIO_ROOT_PASSWORD:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_EVENT_UPLOAD_PREFIX": "events/",
        "LANGFUSE_S3_MEDIA_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_MEDIA_UPLOAD_REGION": "auto",
        "LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID": "langfuse",
        "LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY": "${MINIO_ROOT_PASSWORD:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT": "http://localhost:9090",
        "LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_MEDIA_UPLOAD_PREFIX": "media/",
        "NEXTAUTH_SECRET": "${NEXTAUTH_SECRET:?run scripts/langfuse_stack.py init}",
        "AUTH_DISABLE_SIGNUP": "true",
        "LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT": "http://minio:9000",
        "LANGFUSE_INIT_ORG_ID": "${LANGFUSE_INIT_ORG_ID:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_INIT_PROJECT_ID": "${LANGFUSE_INIT_PROJECT_ID:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_INIT_PROJECT_PUBLIC_KEY": "${LANGFUSE_INIT_PROJECT_PUBLIC_KEY:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_INIT_PROJECT_SECRET_KEY": "${LANGFUSE_INIT_PROJECT_SECRET_KEY:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_INIT_USER_EMAIL": "${LANGFUSE_INIT_USER_EMAIL:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_INIT_USER_PASSWORD": "${LANGFUSE_INIT_USER_PASSWORD:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_INIT_ORG_NAME": "Agent local",
        "LANGFUSE_INIT_PROJECT_NAME": "Agent development",
        "LANGFUSE_INIT_USER_NAME": "Local operator"
      },
      "image": "docker.io/langfuse/langfuse:4.38.0@sha256:47ef2f121e2959c8458c209d118949ade25778017e3f5b75b1e45f72276811c3",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "worker": {
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        },
        "redis": {
          "condition": "service_healthy"
        },
        "clickhouse": {
          "condition": "service_healthy"
        },
        "minio": {
          "condition": "service_healthy"
        }
      },
      "environment": {
        "NEXTAUTH_URL": "http://localhost:3000",
        "DATABASE_URL": "postgresql://langfuse:${POSTGRES_PASSWORD:?run scripts/langfuse_stack.py init}@postgres:5432/langfuse",
        "SALT": "${SALT:?run scripts/langfuse_stack.py init}",
        "ENCRYPTION_KEY": "${ENCRYPTION_KEY:?run scripts/langfuse_stack.py init}",
        "TELEMETRY_ENABLED": "false",
        "LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES": "false",
        "CLICKHOUSE_MIGRATION_URL": "clickhouse://clickhouse:9000",
        "CLICKHOUSE_URL": "http://clickhouse:8123",
        "CLICKHOUSE_USER": "langfuse",
        "CLICKHOUSE_PASSWORD": "${CLICKHOUSE_PASSWORD:?run scripts/langfuse_stack.py init}",
        "CLICKHOUSE_CLUSTER_ENABLED": "false",
        "CLICKHOUSE_CLUSTER_NAME": "default",
        "REDIS_HOST": "redis",
        "REDIS_PORT": "6379",
        "REDIS_AUTH": "${REDIS_AUTH:?run scripts/langfuse_stack.py init}",
        "REDIS_TLS_ENABLED": "false",
        "LANGFUSE_S3_BATCH_EXPORT_ENABLED": "false",
        "LANGFUSE_S3_EVENT_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_EVENT_UPLOAD_REGION": "auto",
        "LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID": "langfuse",
        "LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY": "${MINIO_ROOT_PASSWORD:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_EVENT_UPLOAD_PREFIX": "events/",
        "LANGFUSE_S3_MEDIA_UPLOAD_BUCKET": "langfuse",
        "LANGFUSE_S3_MEDIA_UPLOAD_REGION": "auto",
        "LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID": "langfuse",
        "LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY": "${MINIO_ROOT_PASSWORD:?run scripts/langfuse_stack.py init}",
        "LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT": "http://minio:9000",
        "LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE": "true",
        "LANGFUSE_S3_MEDIA_UPLOAD_PREFIX": "media/"
      },
      "image": "docker.io/langfuse/langfuse-worker:4.38.0@sha256:8631cf429efc4a2981d4e6ced4c005b9f6f620a4e34625baf60152301ec6d006",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "postgres": {
      "environment": {
        "POSTGRES_USER": "langfuse",
        "POSTGRES_DB": "langfuse",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD:?run scripts/langfuse_stack.py init}",
        "TZ": "UTC",
        "PGTZ": "UTC"
      },
      "volumes": [
        "postgres_data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U langfuse -d langfuse"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "20s"
      },
      "image": "docker.io/library/postgres:17@sha256:f4c66b820c6f974249089d3d16d86a3698eae11e8746eb6644b2271031e91232",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "redis": {
      "command": [
        "redis-server",
        "--requirepass",
        "${REDIS_AUTH:?run scripts/langfuse_stack.py init}",
        "--appendonly",
        "yes",
        "--maxmemory-policy",
        "noeviction"
      ],
      "environment": {
        "REDISCLI_AUTH": "${REDIS_AUTH:?run scripts/langfuse_stack.py init}"
      },
      "volumes": [
        "redis_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "redis-cli",
          "ping"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "20s"
      },
      "image": "docker.io/library/redis:7@sha256:c6eabf748fc7a61dbb5a705c78bcf3d6377b1127a97d0ce965c11c44ba46896f",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "clickhouse": {
      "user": "101:101",
      "environment": {
        "CLICKHOUSE_DB": "default",
        "CLICKHOUSE_USER": "langfuse",
        "CLICKHOUSE_PASSWORD": "${CLICKHOUSE_PASSWORD:?run scripts/langfuse_stack.py init}"
      },
      "volumes": [
        "clickhouse_data:/var/lib/clickhouse",
        "clickhouse_logs:/var/log/clickhouse-server"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:8123/ping || exit 1"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "20s"
      },
      "ulimits": {
        "nofile": {
          "soft": 262144,
          "hard": 262144
        }
      },
      "image": "docker.io/clickhouse/clickhouse-server:25.12@sha256:8a790dd3468db22b1d4e7b18a176f378ff5ff6053b9c48dd4ea1fa71a24c5ba6",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "minio": {
      "entrypoint": [
        "sh"
      ],
      "command": [
        "-c",
        "mkdir -p /data/langfuse && minio server --address \":9000\" --console-address \":9001\" /data"
      ],
      "environment": {
        "MINIO_ROOT_USER": "langfuse",
        "MINIO_ROOT_PASSWORD": "${MINIO_ROOT_PASSWORD:?run scripts/langfuse_stack.py init}"
      },
      "ports": [
        "127.0.0.1:9090:9000"
      ],
      "volumes": [
        "minio_data:/data"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "mc",
          "ready",
          "local"
        ],
        "interval": "5s",
        "timeout": "5s",
        "retries": 20,
        "start_period": "20s"
      },
      "image": "cgr.dev/chainguard/minio:latest@sha256:22bf0ad174612a0106dfbbb95818f307525dd32c5a6ec119ecd7273815abe456",
      "restart": "unless-stopped",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "volumes": {
    "postgres_data": {},
    "redis_data": {},
    "clickhouse_data": {},
    "clickhouse_logs": {},
    "minio_data": {}
  }
}
