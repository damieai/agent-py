{
  "title": "Agent runtime overview",
  "uid": "agent-runtime",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "agent-py"
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Tenant admission",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant, state) (agent_admission)",
          "legendFormat": "{{tenant}} {{state}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task states",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant, state) (agent_tasks)",
          "legendFormat": "{{tenant}} {{state}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Unconfirmed action age (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant) (agent_oldest_unconfirmed_seconds)",
          "legendFormat": "{{tenant}} {{state}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Workflow start backlog",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant) (agent_outbox_pending)",
          "legendFormat": "{{tenant}} {{state}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "API response creation P95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(agent_http_duration_seconds_bucket{job=\"agent-api\"}[5m])))",
          "legendFormat": "{{tenant}} {{state}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Worker tick rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(agent_worker_ticks_total{job=\"agent-worker\"}[5m]))",
          "legendFormat": "{{tenant}} {{state}} {{route}} {{result}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Shared enterprise read circuits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant, provider, state) (agent_dependency_circuits)",
          "legendFormat": "{{tenant}} {{provider}} {{state}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Shared enterprise read slots",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tenant, provider, state) (agent_dependency_read_slots)",
          "legendFormat": "{{tenant}} {{provider}} {{state}}"
        }
      ]
    }
  ]
}
