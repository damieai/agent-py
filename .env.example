AGENT_ENVIRONMENT=development
AGENT_DATABASE_URL=sqlite:///.runtime/agent.db
AGENT_ARTIFACT_ROOT=.runtime/artifacts
# Generate a random secret; never use the test secret outside tests.
AGENT_AUTH_SECRET=
AGENT_AUTH_ISSUER=agent-py-local
AGENT_AUTH_AUDIENCE=agent-py
AGENT_EXECUTION_MODE=simulation
AGENT_TEMPORAL_ADDRESS=localhost:7233
AGENT_MODEL_ID=
AGENT_MODEL_API_KEY=
# Explicit opt-in for paid read-only investigation in live mode.
AGENT_ALLOW_MODEL_API=false
AGENT_MODEL_INPUT_MICRO_PER_TOKEN=0
AGENT_MODEL_OUTPUT_MICRO_PER_TOKEN=0
AGENT_DAILY_BUDGET_MICRO_USD=20000000
