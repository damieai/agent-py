AGENT_ENVIRONMENT=development
AGENT_DATABASE_URL=sqlite:///.runtime/agent.db
AGENT_ARTIFACT_ROOT=.runtime/artifacts
# Generate a random secret; never use the test secret outside tests.
AGENT_AUTH_SECRET=
AGENT_AUTH_ISSUER=agent-py-local
AGENT_AUTH_AUDIENCE=agent-py
# Optional trusted local JWKS; mutually exclusive with AGENT_AUTH_PUBLIC_KEY.
# AGENT_AUTH_JWKS_FILE=/absolute/operator-owned/path/jwks.json
AGENT_AUTH_TOKEN_TYPE=JWT
AGENT_AUTH_MAX_TOKEN_LIFETIME_SECONDS=3600
AGENT_AUTH_CLOCK_SKEW_SECONDS=0
AGENT_EXECUTION_MODE=simulation
AGENT_TEMPORAL_ADDRESS=localhost:7233
AGENT_MODEL_ID=
AGENT_MODEL_API_KEY=
# Explicit opt-in for paid read-only investigation in live mode.
AGENT_ALLOW_MODEL_API=false
AGENT_MODEL_INPUT_MICRO_PER_TOKEN=0
AGENT_MODEL_OUTPUT_MICRO_PER_TOKEN=0
# Optional operator-owned JSON manifest for scoped read-only evidence collection.
# AGENT_COLLECTION_MANIFEST=/absolute/path/to/collection-manifest.json
AGENT_DAILY_BUDGET_MICRO_USD=20000000
# Worker defaults initialize the shared tenant policy once; use admission-limit thereafter.
AGENT_MAX_ACTIVE_PER_TENANT=8
AGENT_MAX_QUEUE_PER_TENANT=100
AGENT_WORKER_ACTIVITY_LIMIT=8
# Initializes shared per-tenant/dependency read limits; update existing rows via dependency-limit.
AGENT_MAX_READS_PER_DEPENDENCY=4
AGENT_WORKER_LEASE_SECONDS=360
# Separate random monitoring credential, at least 32 characters. Empty disables metrics.
AGENT_METRICS_SECRET=
AGENT_MONITORING_TENANTS=[]
# Opt-in sparse retrieval with line provenance; default preserves existing inference inputs.
AGENT_CONTEXT_STRATEGY=lexical
AGENT_WORKER_METRICS_ENABLED=false
AGENT_WORKER_METRICS_HOST=127.0.0.1
AGENT_WORKER_METRICS_PORT=9465
# Optional private per-process rotating JSONL trace files; see docs/operations.md.
# AGENT_TRACE_FILE=.runtime/traces/agent.jsonl
# Optional audit signing; provision trust.json independently to offline verifiers.
# AGENT_AUDIT_SIGNING_MANIFEST=/absolute/operator-owned/path/signer.json
# Independent container verification, disabled until explicitly configured.
AGENT_SANDBOX_IMAGE=
# AGENT_SANDBOX_ORACLE=/absolute/path/to/operator-owned-oracle
AGENT_SANDBOX_ROOT=.runtime/sandboxes
AGENT_SANDBOX_TIMEOUT_SECONDS=120
# Bounded candidate repair is separate from read-only investigation.
AGENT_ALLOW_CANDIDATE_EXECUTION=false
# AGENT_REPAIR_MANIFEST=/absolute/path/to/operator-owned-repair-manifest.json
# Optional operator-pinned release; provide manifest and independently trusted ID together.
# AGENT_RELEASE_MANIFEST=/app/releases/candidate.json
# AGENT_RELEASE_EXPECTED_ID=sha256:REPLACE_WITH_64_HEX
# AGENT_RELEASE_ROOT=/app

# Optional short-lived release attestation; configure all three with a pinned release.
# AGENT_RELEASE_ATTESTATION=/app/releases/current.attestation.json
# AGENT_RELEASE_TRUST_STORE=/trusted/release-trust.json
# AGENT_RELEASE_AUDIENCE=engineering-staging

# Optional LF-01 metadata foundation; install with uv sync --extra dev --extra langfuse.
# Exactly one tenant/project per process. All other tenant spans are filtered.
AGENT_LANGFUSE_ENABLED=false
# AGENT_LANGFUSE_BASE_URL=https://your-langfuse-origin
# AGENT_LANGFUSE_TENANT=demo
# AGENT_LANGFUSE_PUBLIC_KEY=pk-lf-...
# AGENT_LANGFUSE_SECRET_KEY=sk-lf-...
# AGENT_LANGFUSE_PSEUDONYM_KEY=INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AGENT_LANGFUSE_QUEUE_SIZE=256
AGENT_LANGFUSE_TIMEOUT_SECONDS=2
AGENT_LANGFUSE_FLUSH_SECONDS=3
